<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CRadventure.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CRadventure.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="CRadventure">

    <!-- Pantalla de Login inicial -->
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="LoginPage" />
    

    <!-- Pestañas -->
    <TabBar>
        <Tab Title="Tour" Icon="tour.png" Route="TourPage">
            <ShellContent ContentTemplate="{DataTemplate local:TourPage}" />
        </Tab>
        <Tab Title="Mapa" Icon="mapa.png" Route="MapaPage">
            <ShellContent ContentTemplate="{DataTemplate local:MapaPage}" />
        </Tab>
        <Tab Title="Reservas" Icon="reservas.png" Route="ReservaPage">
            <ShellContent ContentTemplate="{DataTemplate local:ReservaPage}" />
        </Tab>
        <Tab Title="Perfil" Icon="perfil.png" Route="PerfilPage">
            <ShellContent ContentTemplate="{DataTemplate local:PerfilPage}" />
        </Tab>
    </TabBar>

    

</Shell>
