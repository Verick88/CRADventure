<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CRadventure.Views.TourPage"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Image Source="dashboard.png" 
               Aspect="AspectFill" 
               HorizontalOptions="Fill" 
               VerticalOptions="Fill"/>

        <BoxView BackgroundColor="#CC0A140E" />

        <!-- Contenedor Principal en Grid con 3 filas: Título, Búsqueda y Lista -->
        <Grid RowDefinitions="Auto, Auto, *" Margin="15" RowSpacing="10">

            <!-- Fila 0: TÍTULO CENTRADO CON IMÁGENES -->
            <Border Grid.Row="0"
                    BackgroundColor="#1C2520"
                    Stroke="#33FFFFFF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="15,8"
                    HorizontalOptions="Fill">

                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                    <!-- Imagen izquierda -->
                    <Image Grid.Column="0"
                           Source="ubicacion2.png"
                           WidthRequest="22"
                           HeightRequest="22"
                           VerticalOptions="Center"
                           Aspect="AspectFit"/>

                    <!-- Texto Centrado -->
                    <Label Grid.Column="1"
                           Text="¡Elige tu destino!"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"/>

                    <!-- Imagen derecha -->
                    <Image Grid.Column="2"
                           Source="ubicacion2.png"
                           WidthRequest="22"
                           HeightRequest="22"
                           VerticalOptions="Center"
                           Aspect="AspectFit"/>

                </Grid>
            </Border>

            <!-- Fila 1: BARRA SUPERIOR (Búsqueda y Filtros) -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="10">

                <!-- Barra de búsqueda por título -->
                <SearchBar Grid.Column="0"
                           Placeholder="Buscar por título..."
                           Text="{Binding TextoBusqueda}"
                           TextColor="White"
                           PlaceholderColor="#A0A0A0"
                           BackgroundColor="#1C2520"
                           CancelButtonColor="White"
                           HeightRequest="48" />

                <!-- Botón de filtros con imagen -->
                <ImageButton Grid.Column="1"
                             Clicked="AbrirFiltros"
                             Source="filtro.png"
                             BackgroundColor="#1C2520"
                             WidthRequest="48"
                             HeightRequest="48"
                             CornerRadius="8"
                             Aspect="AspectFit"
                             Padding="10" />

            </Grid>

            <!-- Fila 2: Lista de Tours con Scroll habilitado -->
            <CollectionView Grid.Row="2"
                            x:Name="cvTours" 
                            ItemsSource="{Binding ToursFiltrados}"
                            VerticalOptions="Fill"
                            HorizontalOptions="Fill"
                            SelectionMode="Single"
                            SelectionChanged="ClickTour">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6" 
                                BackgroundColor="#1C2520" 
                                WidthRequest="350"
                                Stroke="#33FFFFFF"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20">

                            <VerticalStackLayout Spacing="0">

                                <!-- 1. IMAGEN Y ELEMENTOS FLOTANTES -->
                                <Grid HeightRequest="200">
                                    <Image Source="{Binding ImagenUrl}" 
                                           Aspect="AspectFill" 
                                           HeightRequest="200"
                                           HorizontalOptions="Fill"/>

                                    <!-- ETIQUETA DE PLAZAS DISPONIBLES (Izquierda Arriba) -->
                                    <Border Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,4"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Start"
                                            Margin="12"
                                            BackgroundColor="#99000000">
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Label Text="🎟️" FontSize="11" VerticalOptions="Center"/>
                                            <Label Text="{Binding PlazasDisponibles, StringFormat='{0} disp.'}"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   FontSize="11"
                                                   VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <!-- ETIQUETA DE DIFICULTAD -->
                                    <Border Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,4"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="12"
                                            BackgroundColor="#7F8C8D">

                                        <Label Text="{Binding Dificultad}"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               FontSize="11"/>

                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Dificultad}" Value="Fácil">
                                                <Setter Property="BackgroundColor" Value="#27AE60" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Dificultad}" Value="Media">
                                                <Setter Property="BackgroundColor" Value="#F39C12" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Dificultad}" Value="Alta">
                                                <Setter Property="BackgroundColor" Value="#C0392B" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>

                                    <!-- ETIQUETA DE PROVINCIA -->
                                    <Border Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,4"
                                            HorizontalOptions="End"
                                            VerticalOptions="End"
                                            Margin="12"
                                            BackgroundColor="#99000000">
                                        <Label Text="{Binding Provincia}"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               FontSize="12"/>
                                    </Border>
                                </Grid>

                                <!-- 2. CONTENIDO DE TEXTO -->
                                <VerticalStackLayout Padding="15" Spacing="6">

                                    <Label Text="{Binding NombreLugar}" 
                                           TextColor="White" 
                                           FontSize="18" 
                                           FontAttributes="Bold"/>

                                    <Label Text="★★★★★" 
                                           TextColor="#FFD700" 
                                           FontSize="14"/>

                                    <Label Text="{Binding IdiomasTexto}" 
                                           TextColor="#B0BEC5" 
                                           FontSize="12" 
                                           FontAttributes="Italic"/>

                                    <!-- Fecha y Hora del Tour -->
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="📅" FontSize="12" VerticalOptions="Center"/>
                                        <Label Text="{Binding FechaHoraVisual}" 
                                               TextColor="#4DB6AC" 
                                               FontSize="13" 
                                               FontAttributes="Bold"/>
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding DescripcionCorta}" 
                                           TextColor="#B0BEC5" 
                                           FontSize="12"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"/>

                                    <!-- Precio (Izquierda) y Duración en Horas (Derecha) -->
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                                        <Label Grid.Column="0"
                                               Text="{Binding PrecioVisual}" 
                                               TextColor="#93C94A" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               HorizontalOptions="Start"/>

                                        <Label Grid.Column="1"
                                               Text="{Binding DuracionVisual}" 
                                               TextColor="#CFD8DC" 
                                               FontSize="13" 
                                               VerticalOptions="Center"
                                               HorizontalOptions="End"/>
                                    </Grid>

                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <!-- Botón flotante para agregar tour -->
        <ImageButton x:Name="btnAgregarTour"
                     Source="editar.png" 
                     WidthRequest="70" 
                     HeightRequest="70"
                     HorizontalOptions="End" 
                     VerticalOptions="End"
                     Margin="30"
                     BackgroundColor="Transparent"
                     Clicked="AgregarTour" />
    </Grid>
</ContentPage>