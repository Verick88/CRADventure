<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CRadventure.Views.TourPage"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Image Source="dashboard.png" 
               Aspect="AspectFill" 
               HorizontalOptions="Fill" 
               VerticalOptions="Fill"/>

        <BoxView BackgroundColor="#CC0A140E" />

        <CollectionView x:Name="cvTours" 
                        Margin="15"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill"
                        SelectionMode="Single"
                        SelectionChanged="ClickTour">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,10" 
                            BackgroundColor="#1C2520" 
                            WidthRequest="350"
                            Stroke="#33FFFFFF"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20">

                        <VerticalStackLayout Spacing="0">

                            <!-- 1. IMAGEN Y ELEMENTOS FLOTANTES -->
                            <Grid HeightRequest="200">
                                <Image Source="{Binding ImagenUrl}" 
                                       Aspect="AspectFill" 
                                       HeightRequest="200"
                                       HorizontalOptions="Fill"/>

                                <!-- ETIQUETA DE DIFICULTAD (Arriba a la derecha con esquinas redondeadas) -->
                                <Border Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="10,4"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="12"
                                        BackgroundColor="#7F8C8D">
                                    <!-- Color gris neutro por defecto si no hace match -->

                                    <Label Text="{Binding Dificultad}"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           FontSize="11"/>

                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Dificultad}" Value="Fácil">
                                            <Setter Property="BackgroundColor" Value="#27AE60" />
                                            <!-- Verde -->
                                        </DataTrigger>

                                        <DataTrigger TargetType="Border" Binding="{Binding Dificultad}" Value="Media">
                                            <Setter Property="BackgroundColor" Value="#F39C12" />
                                            <!-- Amarillo/Naranja -->
                                        </DataTrigger>

                                        <DataTrigger TargetType="Border" Binding="{Binding Dificultad}" Value="Alta">
                                            <Setter Property="BackgroundColor" Value="#C0392B" />
                                            <!-- Rojo -->
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- ETIQUETA DE PROVINCIA (Abajo a la derecha con fondo oscuro elegante) -->
                                <Border Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8,4"
                                        HorizontalOptions="End"
                                        VerticalOptions="End"
                                        Margin="12"
                                        BackgroundColor="#99000000">
                                    <Label Text="{Binding Provincia}"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           FontSize="12"/>
                                </Border>
                            </Grid>

                            <!-- 2. CONTENIDO DE TEXTO -->
                            <VerticalStackLayout Padding="15" Spacing="6">

                                <Label Text="{Binding NombreLugar}" 
                                       TextColor="White" 
                                       FontSize="18" 
                                       FontAttributes="Bold"/>

                                <Label Text="★★★★★" 
                                       TextColor="#FFD700" 
                                       FontSize="14"/>

                                <Label Text="{Binding IdiomasTexto}" 
                                       TextColor="#B0BEC5" 
                                       FontSize="12" 
                                       FontAttributes="Italic"/>

                                <!-- Fecha y Hora del Tour -->
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="📅" FontSize="12" VerticalOptions="Center"/>
                                    <Label Text="{Binding FechaHoraVisual}" 
                                           TextColor="#4DB6AC" 
                                           FontSize="13" 
                                           FontAttributes="Bold"/>
                                </HorizontalStackLayout>

                                <Label Text="{Binding DescripcionCorta}" 
                                       TextColor="#B0BEC5" 
                                       FontSize="12"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"/>

                                <!-- Precio (Izquierda) y Duración en Horas (Derecha) -->
                                <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">

                                    <!-- Precio a la izquierda -->
                                    <Label Grid.Column="0"
           Text="{Binding PrecioVisual}" 
           TextColor="#93C94A" 
           FontSize="16" 
           FontAttributes="Bold"
           HorizontalOptions="Start"/>

                                    <!-- Duración a la derecha del todo -->
                                    <Label Grid.Column="1"
           Text="{Binding DuracionVisual}" 
           TextColor="#CFD8DC" 
           FontSize="13" 
           VerticalOptions="Center"
           HorizontalOptions="End"/>

                                </Grid>

                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ImageButton x:Name="btnAgregarTour"
                     Source="editar.png" 
                     WidthRequest="70" 
                     HeightRequest="70"
                     HorizontalOptions="End" 
                     VerticalOptions="End"
                     Margin="30"
                     BackgroundColor="Transparent"
                     Clicked="AgregarTour" />
    </Grid>
</ContentPage>