<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CRadventure.Views.AgregarTourPage"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Fondo de pantalla -->
        <Image Source="dashboard.png" 
               Aspect="AspectFill" 
               HorizontalOptions="Fill" 
               VerticalOptions="Fill"/>

        <BoxView BackgroundColor="#CC0A140E" />

        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="15">

                <!-- Btn de regresar y titulo -->
                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,10">
                    <Button Grid.Column="0"
                            Text="◀" 
                            Clicked="Regresarbtn"
                            BackgroundColor="#1C2520" 
                            TextColor="White"
                            CornerRadius="10"
                            WidthRequest="45"
                            HeightRequest="45"
                            VerticalOptions="Center"/>

                    <!-- Recuadro para el titulo -->
                    <Border Grid.Column="1"
                            BackgroundColor="#1C2520"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="45"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                            Margin="10,0,0,0"
                            Padding="10,0">
                        <Label Text="Crear Nuevo Tour"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>


                </Grid>

                <!-- Titulo del tour -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Título del Tour" 
                           TextColor="#B0BEC5" 
                           FontSize="13"/>
                    <Entry x:Name="txtNombre" 
                           Placeholder="Ej. Volcán Irazú" 
                           TextColor="White" 
                           PlaceholderColor="#607D8B" 
                           BackgroundColor="#1C2520" 
                           HeightRequest="45"/>
                </VerticalStackLayout>

                <!-- URL de la imagen -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="URL de la Imagen" 
                           TextColor="#B0BEC5" 
                           FontSize="13"/>
                    <Entry x:Name="txtImagenUrl" 
                           Placeholder="https://..." 
                           TextColor="White" 
                           PlaceholderColor="#607D8B" 
                           BackgroundColor="#1C2520" 
                           HeightRequest="45"/>
                </VerticalStackLayout>

                <!-- Provincia y dificultad -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Provincia" 
                               TextColor="#B0BEC5" 
                               FontSize="13"/>
                        <Picker x:Name="pickerProvincia" 
                                Title="Seleccione" 
                                TextColor="White" 
                                BackgroundColor="#1C2520" 
                                HeightRequest="45">
                            <Picker.Items>
                                <x:String>Puntarenas</x:String>
                                <x:String>San José</x:String>
                                <x:String>Alajuela</x:String>
                                <x:String>Cartago</x:String>
                                <x:String>Heredia</x:String>
                                <x:String>Guanacaste</x:String>
                                <x:String>Limón</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Dificultad" 
                               TextColor="#B0BEC5" 
                               FontSize="13"/>
                        <Picker x:Name="pickerDificultad" 
                                Title="Seleccione" 
                                TextColor="White" 
                                BackgroundColor="#1C2520" 
                                HeightRequest="45">
                            <Picker.Items>
                                <x:String>Fácil</x:String>
                                <x:String>Media</x:String>
                                <x:String>Alta</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </Grid>

                <!-- Precios nacional y extranjero -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Precio Nacional (CRC)" 
                               TextColor="#B0BEC5" 
                               FontSize="13"/>
                        <Entry x:Name="txtPrecioNacional" 
                               Placeholder="Ej. 10000" 
                               Keyboard="Numeric" 
                               TextColor="White" 
                               PlaceholderColor="#607D8B" 
                               BackgroundColor="#1C2520" 
                               HeightRequest="45"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Precio Extranjero (USD)" 
                               TextColor="#B0BEC5" 
                               FontSize="13"/>
                        <Entry x:Name="txtPrecioExtranjero" 
                               Placeholder="Opcional (Auto)" 
                               Keyboard="Numeric" 
                               TextColor="White" 
                               PlaceholderColor="#607D8B" 
                               BackgroundColor="#1C2520" 
                               HeightRequest="45"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Duracion e idiomas -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Duración (Horas)" 
                               TextColor="#B0BEC5" 
                               FontSize="13"/>
                        <Entry x:Name="txtDuracion" 
                               Placeholder="Ej. 3" 
                               Keyboard="Numeric" 
                               TextColor="White" 
                               PlaceholderColor="#607D8B" 
                               BackgroundColor="#1C2520" 
                               HeightRequest="45"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Idiomas" 
                               TextColor="#B0BEC5" 
                               FontSize="13"/>
                        <Entry x:Name="txtIdiomas" 
                               Placeholder="Ej. Español, Inglés" 
                               TextColor="White" 
                               PlaceholderColor="#607D8B" 
                               BackgroundColor="#1C2520" 
                               HeightRequest="45"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Plazas disponibles y guias adicionales -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Plazas Disponibles" 
                               TextColor="#B0BEC5" 
                               FontSize="13"/>
                        <Entry x:Name="txtPlazas" 
                               Placeholder="Ej. 15" 
                               Keyboard="Numeric" 
                               TextColor="White" 
                               PlaceholderColor="#607D8B" 
                               BackgroundColor="#1C2520" 
                               HeightRequest="45"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Guías Adicionales" 
                               TextColor="#B0BEC5" 
                               FontSize="13"/>
                        <Entry x:Name="txtGuiasAdicionales" 
                               Placeholder="Opcional" 
                               TextColor="White" 
                               PlaceholderColor="#607D8B" 
                               BackgroundColor="#1C2520" 
                               HeightRequest="45"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Fecha y hora -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Fecha y Hora (Visual)" 
                           TextColor="#B0BEC5" 
                           FontSize="13"/>
                    <Entry x:Name="txtFecha" 
                           Placeholder="Ej. 27 Septiembre 2026 - 9:00am" 
                           TextColor="White" 
                           PlaceholderColor="#607D8B" 
                           BackgroundColor="#1C2520" 
                           HeightRequest="45"/>
                </VerticalStackLayout>

                <!-- Descripcion corta -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Descripción Corta (Tarjeta)" 
                           TextColor="#B0BEC5" 
                           FontSize="13"/>
                    <Editor x:Name="txtDescCorta"  
                            Placeholder="Resumen visible en la lista..." 
                            MaxLength="60" 
                            TextColor="White" 
                            PlaceholderColor="#607D8B" 
                            BackgroundColor="#1C2520" 
                            HeightRequest="70"/>
                </VerticalStackLayout>

                <!-- Descripcion larga -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Descripción Larga (Detalle de Reserva)" 
                           TextColor="#B0BEC5" 
                           FontSize="13"/>
                    <Editor x:Name="txtDescLarga"  
                            Placeholder="Información completa que se muestra al reservar..." 
                            TextColor="White" 
                            PlaceholderColor="#607D8B" 
                            BackgroundColor="#1C2520" 
                            HeightRequest="100"/>
                </VerticalStackLayout>

                <!-- Punto de encuentro -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Punto de Encuentro" 
                           TextColor="#B0BEC5" 
                           FontSize="13"/>
                    <Entry x:Name="txtPuntoEncuentro" 
                           Placeholder="Ej. Parque central, costado norte..." 
                           TextColor="White" 
                           PlaceholderColor="#607D8B" 
                           BackgroundColor="#1C2520" 
                           HeightRequest="45"/>
                </VerticalStackLayout>

                <!-- Boton de guardar -->
                <Button Text="Guardar Tour"
                        BackgroundColor="#93C94A"
                        TextColor="#0A140E"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="50"
                        CornerRadius="10"
                        Margin="0,15,0,30"
                        Clicked="GuardarTour"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>