<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CRadventure.Views.PerfilPage"
             Title="Mi Perfil">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Encabezado con Título y Cerrar Sesión -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                <Label Text="Configuración de Perfil"
                       FontSize="22"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>

                <Button Grid.Column="1"
                        Text="Cerrar Sesión"
                        Clicked="OnCerrarSesion_Clicked"
                        BackgroundColor="#EF4444"
                        TextColor="White"
                        FontSize="12"
                        HeightRequest="38"
                        VerticalOptions="Center"/>
            </Grid>

            <!-- Correo (Solo lectura) -->
            <Label Text="Correo Electrónico:" FontAttributes="Bold"/>
            <Label x:Name="lblEmail" Text="cargando..." FontSize="16" TextColor="Gray"/>

            <!-- Nombre -->
            <Label Text="Nombre:" FontAttributes="Bold"/>
            <Entry x:Name="txtNombre" Placeholder="Ingresa tu nombre"/>

            <!-- Apellidos -->
            <Label Text="Apellidos:" FontAttributes="Bold"/>
            <Entry x:Name="txtApellidos" Placeholder="Ingresa tus apellidos"/>

            <!-- Teléfono -->
            <Label Text="Teléfono:" FontAttributes="Bold"/>
            <Entry x:Name="txtTelefono" Placeholder="Ingresa tu teléfono" Keyboard="Telephone"/>

            <!-- Botón Guardar -->
            <Button Text="Guardar Cambios"
                    Clicked="OnGuardarClicked"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>