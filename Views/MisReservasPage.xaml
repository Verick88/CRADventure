<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CRadventure.Views.MisReservasPage"
             Title="Mis Reservas"
             BackgroundColor="#121212">

    <Grid>
        <!-- Mensaje si no hay reservas -->
        <VerticalStackLayout x:Name="layoutVacio" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" Spacing="15">
            <Label Text="🎒" FontSize="60" HorizontalOptions="Center"/>
            <Label Text="Aún no tienes aventuras" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
            <Label Text="Tus reservas aparecerán aquí." TextColor="#A0A0A0" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Lista de tarjetas -->
        <CollectionView x:Name="listaReservas" ItemsSource="{Binding MisReservas}" Margin="15,20">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 15" BackgroundColor="#1C2520" Stroke="Transparent" Margin="0,0,0,20">
                        <Grid RowDefinitions="140, Auto">

                            <Image Grid.Row="0" Source="{Binding ImagenUrl}" Aspect="AspectFill" HeightRequest="140"/>

                            <Border Grid.Row="0" BackgroundColor="{Binding ColorEstado}" StrokeShape="RoundRectangle 20" 
                                    HorizontalOptions="End" VerticalOptions="Start" Margin="10" Padding="10,5">
                                <Label Text="{Binding TextoEstado}" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                            </Border>

                            <VerticalStackLayout Grid.Row="1" Padding="15" Spacing="8">
                                <Label Text="{Binding NombreLugar}" FontSize="18" FontAttributes="Bold" TextColor="White"/>

                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="📅" FontSize="14"/>
                                    <Label Text="{Binding FechaTour}" TextColor="#B0BEC5" FontSize="13"/>
                                </HorizontalStackLayout>

                                <BoxView HeightRequest="1" Color="#33FFFFFF" Margin="0,10"/>

                                <Grid ColumnDefinitions="*, *">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="Tiquetes" TextColor="#A0A0A0" FontSize="12"/>
                                        <Label Text="{Binding CantidadEntradas}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="Total Pagado" TextColor="#A0A0A0" FontSize="12" HorizontalOptions="End"/>
                                        <Label Text="{Binding PrecioPagado}" TextColor="#93C94A" FontSize="16" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <Button Text="Cancelar Reserva" 
                                        IsVisible="{Binding EsActiva}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelarReservaCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent" TextColor="#CF0A2C" BorderColor="#CF0A2C"
                                        BorderWidth="1" CornerRadius="8" HeightRequest="40" Margin="0,15,0,0" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>