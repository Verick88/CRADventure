<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CRadventure.Views.MisReservasPage"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Imagen de fondo -->
        <Image Source="mono.png" 
               Aspect="AspectFill" 
               HorizontalOptions="Fill" 
               VerticalOptions="Fill"/>

        <BoxView BackgroundColor="#CC0A140E" />

        <!-- Contenedor principal con grid -->
        <Grid RowDefinitions="Auto, *" Margin="15" RowSpacing="15">

            <!-- Fila 0: Titulo con imagenes -->
            <Border Grid.Row="0"
                    BackgroundColor="#1C2520"
                    Stroke="#33FFFFFF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="15,8"
                    HorizontalOptions="Fill">

                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                    <!-- Imagen izquierda -->
                    <Image Grid.Column="0"
                           Source="reserva.png"
                           WidthRequest="22"
                           HeightRequest="22"
                           VerticalOptions="Center"
                           Aspect="AspectFit"/>

                    <!-- Texto Centrado -->
                    <Label Grid.Column="1"
                           Text="Mis Reservas"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"/>

                    <!-- Imagen derecha -->
                    <Image Grid.Column="2"
                           Source="reserva.png"
                           WidthRequest="22"
                           HeightRequest="22"
                           VerticalOptions="Center"
                           Aspect="AspectFit"/>

                </Grid>
            </Border>

            <!-- Fila 1: Lista o comentario si esta vacio -->
            <Grid Grid.Row="1">
                <!-- Mensaje si no hay reservas -->
                <VerticalStackLayout x:Name="layoutVacio" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" Spacing="15">
                    <Image Source="mochila.png" 
                           WidthRequest="70" 
                           HeightRequest="70" 
                           Aspect="AspectFit" 
                           HorizontalOptions="Center"/>
                    <Label Text="Aún no tienes aventuras" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="White" 
                           HorizontalOptions="Center"/>
                    <Label Text="Tus reservas aparecerán aquí." 
                           TextColor="#A0A0A0" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Lista de tarjetas -->
                <CollectionView x:Name="listaReservas" 
                                ItemsSource="{Binding MisReservas}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 15" 
                                    BackgroundColor="#1C2520" 
                                    Stroke="#33FFFFFF" 
                                    StrokeThickness="1" 
                                    Margin="0,0,0,15">
                                <Grid RowDefinitions="140, Auto">

                                    <Image Grid.Row="0" 
                                           Source="{Binding ImagenUrl}" 
                                           Aspect="AspectFill" 
                                           HeightRequest="140"/>

                                    <Border Grid.Row="0" 
                                            BackgroundColor="{Binding ColorEstado}" 
                                            StrokeShape="RoundRectangle 20" 
                                            HorizontalOptions="End" 
                                            VerticalOptions="Start" 
                                            Margin="10" Padding="10,5" 
                                            Stroke="Transparent">
                                        <Label Text="{Binding TextoEstado}" 
                                               TextColor="White" 
                                               FontSize="11" 
                                               FontAttributes="Bold"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Row="1" Padding="15" Spacing="8">
                                        <Label Text="{Binding NombreLugar}" 
                                               FontSize="18" 
                                               FontAttributes="Bold" 
                                               TextColor="White"/>

                                        <!-- Fecha del Tour -->
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="📅" FontSize="14" VerticalOptions="Center"/>
                                            <Label Text="{Binding FechaTour}" TextColor="#B0BEC5" FontSize="13" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>

                                        <!-- Provincia y Duración -->
                                        <Grid ColumnDefinitions="*, *" Margin="0,2,0,0">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                                <Label Text="📍" FontSize="13" VerticalOptions="Center"/>
                                                <Label Text="{Binding Provincia}" TextColor="#A0A0A0" FontSize="13" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="End">
                                                <Label Text="⏱️" FontSize="13" VerticalOptions="Center"/>
                                                <Label Text="{Binding DuracionTour}" TextColor="#A0A0A0" FontSize="13" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <!-- Punto de Encuentro -->
                                        <Grid ColumnDefinitions="Auto, *" Margin="0,2,0,0">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Start">
                                                <Label Text="🗺️" FontSize="13"/>
                                                <Label Text="Punto:" TextColor="#A0A0A0" FontSize="13"/>
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding PuntoEncuentro}" TextColor="#B0BEC5" FontSize="13" LineBreakMode="WordWrap"/>
                                        </Grid>

                                        <!-- Guía Asociado -->
                                        <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                            <Label Text="👤" FontSize="13" VerticalOptions="Center"/>
                                            <Label Text="Guía:" TextColor="#A0A0A0" FontSize="13" VerticalOptions="Center"/>
                                            <Label Text="{Binding GuiaAsociado}" TextColor="#B0BEC5" FontSize="13" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>

                                        <BoxView HeightRequest="1" 
                                                 Color="#33FFFFFF" 
                                                 Margin="0,8"/>

                                        <Grid ColumnDefinitions="*, *">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="Tiquetes" 
                                                       TextColor="#A0A0A0" 
                                                       FontSize="12"/>
                                                <Label Text="{Binding CantidadEntradas}" 
                                                       TextColor="White" 
                                                       FontSize="16" 
                                                       FontAttributes="Bold"/>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                                <Label Text="Total Pagado" 
                                                       TextColor="#A0A0A0"
                                                       FontSize="12" 
                                                       HorizontalOptions="End"/>
                                                <Label Text="{Binding PrecioPagado}" 
                                                       TextColor="#93C94A" 
                                                       FontSize="16" 
                                                       FontAttributes="Bold"/>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Button Text="Cancelar Reserva" 
                                                IsVisible="{Binding EsActiva}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelarReservaCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent" TextColor="#CF0A2C" BorderColor="#CF0A2C"
                                                BorderWidth="1" CornerRadius="8" HeightRequest="40" Margin="0,15,0,0" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>