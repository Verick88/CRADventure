<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CRadventure.Views.AdminPage"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Fondo -->
        <Image Source="mapa_fondo1.png" 
               Aspect="AspectFill" 
               HorizontalOptions="Fill" 
               VerticalOptions="Fill"/>

        <BoxView BackgroundColor="#CC0A140E" />

        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="25">

                <!-- Boton volver y titulo -->
                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" Margin="0,0,0,5">
                    <Button Grid.Column="0"
                            Text="←"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            Clicked="OnVolverClicked"
                            WidthRequest="50"
                            HeightRequest="50"
                            HorizontalOptions="Start"/>

                    <Label Grid.Column="1"
                           Text="Panel de Administración"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"/>
                </Grid>

                <!-- Seccion busqueda -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Gestión de Permisos" 
                           TextColor="White" 
                           FontSize="18" 
                           FontAttributes="Bold" />

                    <Label Text="Escribe el correo del usuario para buscarlo:" 
                           TextColor="#B0BEC5" 
                           FontSize="13"/>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" Margin="0,5,0,0">
                        <Entry x:Name="txtEmailBusqueda" 
                               Grid.Column="0"
                               Placeholder="correo@ejemplo.com"
                               TextColor="White"
                               PlaceholderColor="#607D8B"
                               BackgroundColor="#1C2520"
                               HeightRequest="45"/>

                        <Button x:Name="btnBuscar"
                                Grid.Column="1"
                                Text="Buscar" 
                                Clicked="OnBuscarClicked"
                                BackgroundColor="#93C94A"
                                TextColor="#0A140E"
                                FontAttributes="Bold"
                                HeightRequest="45"
                                CornerRadius="8"
                                Padding="20,0"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Tarjeta de resultado -->
                <Frame x:Name="frmResultado" 
                       IsVisible="False" 
                       CornerRadius="12" 
                       Padding="20" 
                       BackgroundColor="#1C2520"
                       BorderColor="#2D3B32"
                       HasShadow="True">

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Usuario Encontrado" 
                               FontAttributes="Bold" 
                               FontSize="16"
                               TextColor="#93C94A"/>

                        <BoxView HeightRequest="1" BackgroundColor="#2D3B32" Margin="0,0,0,5"/>

                        <Label x:Name="lblNombreUsuario" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <Label x:Name="lblCorreoUsuario" 
                               TextColor="#607D8B" 
                               FontSize="14"/>

                        <!-- Rol actual -->
                        <HorizontalStackLayout Spacing="6" Margin="0,5,0,5">
                            <Label Text="Rol actual:" 
                                   TextColor="#B0BEC5"
                                   FontAttributes="Bold"/>
                            <Label x:Name="lblRolActual" 
                                   TextColor="#93C94A" 
                                   FontAttributes="Bold"/>
                        </HorizontalStackLayout>

                        <!-- Botones para hacer guia o cliente -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                            <Button Grid.Column="0"
                                    Text="Hacer Cliente"
                                    Clicked="OnRevocarClicked"
                                    BackgroundColor="#EF4444"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    HeightRequest="45"
                                    CornerRadius="8"/>

                            <Button Grid.Column="1"
                                    Text="Hacer Guía"
                                    Clicked="OnAscenderClicked"
                                    BackgroundColor="#93C94A"
                                    TextColor="#0A140E"
                                    FontAttributes="Bold"
                                    HeightRequest="45"
                                    CornerRadius="8"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>