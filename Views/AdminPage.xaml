<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CRadventure.Views.AdminPage"
             Title="Panel de Administración">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Gestión de Permisos" FontSize="24" FontAttributes="Bold" />
        <Label Text="Escribe el correo del usuario para buscarlo:" />

        <!-- CORRECCIÓN 1: Aquí cambiamos Spacing por ColumnSpacing -->
        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <Entry x:Name="txtEmailBusqueda" 
                   Grid.Column="0"
                   Placeholder="correo@ejemplo.com" />

            <!-- Le agregamos Clicked="OnBuscarClicked" para que sepa qué hacer al tocarlo -->
            <Button x:Name="btnBuscar"
                    Grid.Column="1"
                    Text="Buscar" 
                    Clicked="OnBuscarClicked"
                    BackgroundColor="#3b3b98"
                    TextColor="White"/>
        </Grid>

        <!-- Tarjeta de Resultados (Oculta por defecto) -->
        <Frame x:Name="frmResultado" 
               IsVisible="False" 
               CornerRadius="10" 
               Padding="15" 
               BorderColor="LightGray">

            <VerticalStackLayout Spacing="10">
                <Label Text="Usuario Encontrado:" FontAttributes="Bold" FontSize="18"/>

                <!-- vacías porque las llenaremos desde el código -->
                <Label x:Name="lblNombreUsuario" FontSize="16"/>
                <Label x:Name="lblCorreoUsuario" TextColor="Gray" FontSize="14"/>

                <!-- "Rol actual: cliente" en una sola línea -->
                <HorizontalStackLayout Spacing="5">
                    <Label Text="Rol actual:" FontAttributes="Bold"/>
                    <Label x:Name="lblRolActual" TextColor="#3b3b98" FontAttributes="Bold"/>
                </HorizontalStackLayout>

                <!-- CORRECCIÓN 2: Aquí también cambiamos Spacing por ColumnSpacing -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,15,0,0">
                    <Button Grid.Column="0"
                            Text="Hacer Cliente"
                            Clicked="OnRevocarClicked"
                            BackgroundColor="#EF4444"
                            TextColor="White"
                            FontAttributes="Bold"/>

                    <Button Grid.Column="1"
                            Text="Hacer Guía"
                            Clicked="OnAscenderClicked"
                            BackgroundColor="#93C94A"
                            TextColor="#0A140E"
                            FontAttributes="Bold"/>
                </Grid>
            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>