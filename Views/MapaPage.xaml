<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    x:Class="CRadventure.Views.MapaPage"
    NavigationPage.HasNavigationBar="False">

    <Grid>

        <!-- Mapa de fondo -->
        <maps:Map
            x:Name="mapaCostaRica"
            IsShowingUser="False"
            MapType="Street"/>

        <!-- Contenedor principal para superponer elementos flotantes -->
        <Grid Margin="15" RowDefinitions="Auto, *">

            <!-- Fila 0: Título flotante estilizado -->
            <Border Grid.Row="0"
                    BackgroundColor="#1C2520"
                    Stroke="#33FFFFFF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="15,8"
                    HorizontalOptions="Fill"
                    ZIndex="10">

                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                    <!-- Imagen izquierda -->
                    <Image Grid.Column="0"
                           Source="mapa_aventuras.png"
                           WidthRequest="22"
                           HeightRequest="22"
                           VerticalOptions="Center"
                           Aspect="AspectFit"/>

                    <!-- Texto Centrado -->
                    <Label Grid.Column="1"
                           Text="Mapa de Aventuras"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"/>

                    <!-- Imagen derecha -->
                    <Image Grid.Column="2"
                           Source="mapa_aventuras.png"
                           WidthRequest="22"
                           HeightRequest="22"
                           VerticalOptions="Center"
                           Aspect="AspectFit"/>

                </Grid>
            </Border>

        </Grid>

        <!-- Panel flotante inferior (Detalle del Monumento / Lugar) -->
        <Border
            x:Name="panelMonumento"
            IsVisible="False"
            BackgroundColor="#1C2520"
            Stroke="#33FFFFFF"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 20"
            Padding="20"
            Margin="15"
            VerticalOptions="End"
            ZIndex="10">

            <VerticalStackLayout Spacing="12">

                <!-- Imagen cargada desde Firebase con esquinas redondeadas -->
                <Border StrokeShape="RoundRectangle 12" 
                        Stroke="Transparent" 
                        Padding="0" 
                        BackgroundColor="#2A3630">
                    <Image
                        x:Name="imgMonumento"
                        HeightRequest="150"
                        Aspect="AspectFill"/>
                </Border>

                <Label
                    x:Name="lblNombre"
                    FontFamily="Kaushan"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="#93C94A"/>

                <ScrollView HeightRequest="140">
                    <Label
                        x:Name="lblHistoria"
                        FontFamily="MontserratRegular"
                        FontSize="15"
                        TextColor="#B0BEC5"
                        LineBreakMode="WordWrap"/>
                </ScrollView>

                <Button
                    Text="Cerrar"
                    BackgroundColor="Transparent"
                    FontFamily="Kaushan"
                    TextColor="#CF0A2C"
                    BorderColor="#CF0A2C"
                    BorderWidth="1"
                    CornerRadius="8"
                    HeightRequest="45"
                    FontAttributes="Bold"
                    Clicked="CerrarPanel_Clicked"/>

            </VerticalStackLayout>

        </Border>

    </Grid>
</ContentPage>