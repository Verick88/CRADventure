<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CRadventure.Views.ReservaPage"
             Title="Detalle del Tour"
             BackgroundColor="#121212">


    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

            <!-- Imagen del tour-->
            <Image Source="{Binding ImagenUrl}" 
                   HeightRequest="280" 
                   Aspect="AspectFill" 
                   HorizontalOptions="Fill"/>

            <VerticalStackLayout Padding="20" Spacing="15">

                <!-- Titulo principal del lugar -->
                <Label Text="{Binding NombreLugar}" FontSize="24" FontAttributes="Bold" TextColor="White"/>

                <!-- Fecha y hora  -->
                <HorizontalStackLayout Spacing="10">
                    <Label Text="📅" VerticalOptions="Center"/>
                    <Label Text="{Binding FechaHoraVisual}" TextColor="#4DB6AC" FontSize="16" FontAttributes="Bold"/>
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="10" ColumnSpacing="10">
                    
                    <!-- Tarjeta de Provincia -->
                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#1C2520" StrokeShape="RoundRectangle 8" Padding="12">
                        <VerticalStackLayout>
                            <Label Text="📍 Provincia" TextColor="#A0A0A0" FontSize="12"/>
                            <Label Text="{Binding Provincia}" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tarjeta de duracion -->
                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#1C2520" StrokeShape="RoundRectangle 8" Padding="12">
                        <VerticalStackLayout>
                            <Label Text="⏳ Duración" TextColor="#A0A0A0" FontSize="12"/>
                            <Label Text="{Binding DuracionVisual}" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tarjeta de punto de encuentro -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#1C2520" StrokeShape="RoundRectangle 8" Padding="12">
                        <VerticalStackLayout>
                            <Label Text="🚩 Punto de Encuentro" TextColor="#A0A0A0" FontSize="12"/>
                            <Label Text="{Binding PuntoEncuentro}" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Equipo de guias -->
                <Label Text="Equipo del Tour" FontSize="18" FontAttributes="Bold" TextColor="White" Margin="0,10,0,0"/>
                <Label Text="{Binding GuiaAsociado, StringFormat='Guía Principal: {0}'}" TextColor="#B0BEC5"/>
                <Label Text="{Binding GuiasAdicionales, StringFormat='Apoyo: {0}'}" TextColor="#B0BEC5"/>

                <!-- Descripcion larga -->
                <Label Text="Acerca de este tour" FontSize="18" FontAttributes="Bold" TextColor="White" Margin="0,10,0,0"/>
                <Label Text="{Binding DescripcionLarga}" TextColor="#B0BEC5" LineBreakMode="WordWrap"/>

                <BoxView HeightRequest="1" Color="#33FFFFFF" Margin="0,15"/>

                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="15">
                    
                    <!-- Botones para sumar o restar entradas -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                        <Label Text="Cantidad de entradas" TextColor="#A0A0A0" FontSize="14"/>
                        <HorizontalStackLayout Spacing="15" Margin="0,5,0,0">
                            <Button Text="-" Clicked="OnMenosClicked" WidthRequest="45" HeightRequest="45" BackgroundColor="#1C2520" TextColor="White" FontSize="20" FontAttributes="Bold" Padding="0"/>
                            <Label x:Name="lblCantidad" Text="1" FontSize="22" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                            <Button Text="+" Clicked="OnMasClicked" WidthRequest="45" HeightRequest="45" BackgroundColor="#1C2520" TextColor="White" FontSize="20" FontAttributes="Bold" Padding="0"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Plazas disponibles -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                        <Label Text="{Binding PlazasDisponibles, StringFormat='🎟️ {0} disp.'}" TextColor="#F39C12" FontSize="18" FontAttributes="Bold"/>
                    </VerticalStackLayout>

                    <!-- Calculo de precio total -->
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                        <Label Text="Total a pagar" TextColor="#A0A0A0" FontSize="14"/>
                        <Label x:Name="lblTotalPagar" Text="{Binding PrecioVisual}" TextColor="#93C94A" FontSize="24" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Boton para confirmar reserva -->
                <Button Text="Confirmar Reserva" 
                        BackgroundColor="#CF0A2C" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="10"
                        HeightRequest="55"
                        Margin="0,15,0,0"
                        Clicked="OnReservarClicked"/>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>